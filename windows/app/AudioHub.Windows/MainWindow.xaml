<Window
    x:Class="AudioHub.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout statis saja. Matriks dan strip dibangun dari kode setelah perangkat dibuka. Teks diisi
         oleh Localization di MainWindow.xaml.cs (ApplyText), supaya bahasa bisa diganti saat aplikasi berjalan. -->
    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageBox" Width="200" SelectionChanged="LanguageBox_SelectionChanged" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="PhysicalLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="PhysicalBox" Width="240" />
            <CheckBox x:Name="Virt12Check" />
            <CheckBox x:Name="Virt34Check" />
            <CheckBox x:Name="LoopCheck" />
            <Button x:Name="OpenButton" Click="OpenButton_Click" />
            <Button x:Name="CloseButton" Click="CloseButton_Click" />
            <Button x:Name="StartButton" Click="StartButton_Click" />
            <Button x:Name="StopButton" Click="StopButton_Click" />
            <ComboBox x:Name="RecordOutputBox" Width="170" />
            <Button x:Name="RecordButton" Click="RecordButton_Click" />
            <Button x:Name="SaveSceneButton" Click="SaveSceneButton_Click" />
            <Button x:Name="LoadSceneButton" Click="LoadSceneButton_Click" />
            <Button x:Name="RefreshButton" Click="RefreshButton_Click" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <TextBlock x:Name="AppsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="AppsHint" Opacity="0.7" TextWrapping="Wrap" />
                <ListView x:Name="ProcessList" SelectionMode="Multiple" Height="420" />
                <CheckBox x:Name="IsolateCheck" />
            </StackPanel>

            <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="MatrixHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid x:Name="MatrixGrid" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="InputsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel x:Name="InputStrips" Spacing="6" />
                    <TextBlock x:Name="OutputsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel x:Name="OutputStrips" Spacing="6" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Opacity="0.8" TextWrapping="Wrap" />
    </Grid>
</Window>
