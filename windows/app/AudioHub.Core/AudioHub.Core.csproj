<Project Sdk="Microsoft.NET.Sdk">

  <!-- Library murni (tanpa WinUI) berisi P/Invoke ke audiohub_io.dll, parser daftar perangkat, dan format scene.
       Bisa dibangun dan diuji di macOS. Pemanggilan native hanya berjalan di Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AudioHub.Core</RootNamespace>
    <AssemblyName>AudioHub.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AudioHub.Core.Tests" />
  </ItemGroup>

</Project>
